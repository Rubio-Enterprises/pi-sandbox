{
  "name": "Rubio Dev Container",
  "image": "ghcr.io/rubio-enterprises/pi-sandbox/devcontainer:main",
  "containerEnv": {
    "STANDARDS_DEVCONTAINER": "1"
  },
  "onCreateCommand": "bash -c 'source scripts/common/standards-pin.sh && standards_devcontainer_setup \"$PWD\" --check-only'",
  "updateContentCommand": "bash -c 'source scripts/common/standards-pin.sh && standards_devcontainer_setup \"$PWD\"'"
}
