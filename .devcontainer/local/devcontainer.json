{
  "name": "Rubio Dev Container",
  "mounts": ["source=${devcontainerId}-venv,target=${containerWorkspaceFolder}/.venv,type=volume"],
  "securityOpt": ["no-new-privileges=false"],
  "onCreateCommand": "sudo chown \"$(id -u):$(id -g)\" .venv && mise run setup",
  "remoteEnv": {
    "NODE_AUTH_TOKEN": "${localEnv:NODE_AUTH_TOKEN}"
  },
  "build": {
    "dockerfile": "../../.standards/node_modules/@rubio-enterprises/standards/image/Dockerfile",
    "context": "../..",
    "target": "local"
  },
  "features": {}
}
